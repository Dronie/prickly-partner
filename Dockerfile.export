FROM python:3.10-slim
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./

RUN uv sync --locked --no-default-groups --no-install-project --extra export

ENV PATH="/app/.venv/bin:$PATH"

COPY . .

ENV PYTHONPATH="/app"

CMD ["bash", "tools/export.sh", "/app/models/meta_adv"]
